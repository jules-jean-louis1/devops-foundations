#Backend_API
DEV_BACKEND_PORT=3000
PROD_BACKEND_PORT=80

NODE_ENV=development
LOG_LEVEL=debug

# POSTGRES - DEV
POSTGRES_USER_DEV=postgres
POSTGRES_PASSWORD_DEV=password
POSTGRES_DB_DEV=cloudnative_dev
